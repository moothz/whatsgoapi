From: moothz <m.moothz@gmail.com>
Date: Tue, 24 Nov 2026 18:47:44 -0300
Subject: [PATCH] feat(message): add AudioStickerMessage support

---
 send.go                     |  4 ++++
 send_test.go                | 39 +++++++++++++++++++++++++++++++++
 types/events/events.go      |  5 +++++
 types/events/events_test.go | 43 +++++++++++++++++++++++++++++++++++++
 4 files changed, 91 insertions(+)
 create mode 100644 send_test.go
 create mode 100644 types/events/events_test.go

diff --git a/send.go b/send.go
index 2947cd8..5ac9d6e 100644
--- a/send.go
+++ b/send.go
@@ -942,6 +942,8 @@ func getTypeFromMessage(msg *waE2E.Message) string {
 		return getTypeFromMessage(msg.ViewOnceMessageV2Extension.Message)
 	case msg.LottieStickerMessage != nil:
 		return getTypeFromMessage(msg.LottieStickerMessage.Message)
+	case msg.AudioStickerMessage != nil:
+		return getTypeFromMessage(msg.AudioStickerMessage.Message)
 	case msg.EphemeralMessage != nil:
 		return getTypeFromMessage(msg.EphemeralMessage.Message)
 	case msg.DocumentWithCaptionMessage != nil:
@@ -969,6 +971,8 @@ func getMediaTypeFromMessage(msg *waE2E.Message) string {
 		return getMediaTypeFromMessage(msg.ViewOnceMessageV2Extension.Message)
 	case msg.LottieStickerMessage != nil:
 		return getMediaTypeFromMessage(msg.LottieStickerMessage.Message)
+	case msg.AudioStickerMessage != nil:
+		return getMediaTypeFromMessage(msg.AudioStickerMessage.Message)
 	case msg.EphemeralMessage != nil:
 		return getMediaTypeFromMessage(msg.EphemeralMessage.Message)
 	case msg.DocumentWithCaptionMessage != nil:
diff --git a/send_test.go b/send_test.go
new file mode 100644
index 0000000..68e68f4
--- /dev/null
+++ b/send_test.go
@@ -0,0 +1,39 @@
+// Copyright (c) 2026 Tulir Asokan
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package whatsmeow
+
+import (
+	"testing"
+
+	"google.golang.org/protobuf/proto"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+)
+
+func TestGetTypeAndMediaTypeAudioStickerMessage(t *testing.T) {
+	msg := &waE2E.Message{
+		AudioStickerMessage: &waE2E.FutureProofMessage{
+			Message: &waE2E.Message{
+				StickerMessage: &waE2E.StickerMessage{
+					Mimetype: proto.String("image/webp"),
+					Audio: &waE2E.StickerMessage_AudioMessage{
+						AudioMessage: &waE2E.AudioMessage{
+							Mimetype: proto.String("audio/ogg; codecs=opus"),
+						},
+					},
+				},
+			},
+		},
+	}
+
+	if got := getTypeFromMessage(msg); got != "media" {
+		t.Fatalf("getTypeFromMessage(AudioStickerMessage) = %q, want %q", got, "media")
+	}
+	if got := getMediaTypeFromMessage(msg); got != "sticker" {
+		t.Fatalf("getMediaTypeFromMessage(AudioStickerMessage) = %q, want %q", got, "sticker")
+	}
+}
diff --git a/types/events/events.go b/types/events/events.go
index a273127..3659678 100644
--- a/types/events/events.go
+++ b/types/events/events.go
@@ -329,6 +329,7 @@ type Message struct {
 	IsViewOnceV2Extension bool // True if the message was unwrapped from a ViewOnceMessageV2Extension
 	IsDocumentWithCaption bool // True if the message was unwrapped from a DocumentWithCaptionMessage
 	IsLottieSticker       bool // True if the message was unwrapped from a LottieStickerMessage
+	IsAudioSticker        bool // True if the message was unwrapped from an AudioStickerMessage
 	IsBotInvoke           bool // True if the message was unwrapped from a BotInvokeMessage
 	IsEdit                bool // True if the message was unwrapped from an EditedMessage
 
@@ -410,6 +411,10 @@ func (evt *Message) UnwrapRaw() *Message {
 		evt.Message = evt.Message.GetLottieStickerMessage().GetMessage()
 		evt.IsLottieSticker = true
 	}
+	if evt.Message.GetAudioStickerMessage().GetMessage() != nil {
+		evt.Message = evt.Message.GetAudioStickerMessage().GetMessage()
+		evt.IsAudioSticker = true
+	}
 	if evt.Message.GetDocumentWithCaptionMessage().GetMessage() != nil {
 		evt.Message = evt.Message.GetDocumentWithCaptionMessage().GetMessage()
 		evt.IsDocumentWithCaption = true
diff --git a/types/events/events_test.go b/types/events/events_test.go
new file mode 100644
index 0000000..4f274c0
--- /dev/null
+++ b/types/events/events_test.go
@@ -0,0 +1,43 @@
+// Copyright (c) 2026 Tulir Asokan
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package events
+
+import (
+	"testing"
+
+	"google.golang.org/protobuf/proto"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+)
+
+func TestMessageUnwrapRawAudioStickerMessage(t *testing.T) {
+	raw := &waE2E.Message{
+		AudioStickerMessage: &waE2E.FutureProofMessage{
+			Message: &waE2E.Message{
+				StickerMessage: &waE2E.StickerMessage{
+					Mimetype: proto.String("image/webp"),
+					Audio: &waE2E.StickerMessage_AudioMessage{
+						AudioMessage: &waE2E.AudioMessage{
+							Mimetype: proto.String("audio/ogg; codecs=opus"),
+						},
+					},
+				},
+			},
+		},
+	}
+
+	evt := (&Message{RawMessage: raw}).UnwrapRaw()
+	if !evt.IsAudioSticker {
+		t.Fatalf("expected IsAudioSticker = true")
+	}
+	if evt.Message.GetStickerMessage() == nil {
+		t.Fatalf("expected unwrapped StickerMessage")
+	}
+	if evt.Message.GetStickerMessage().GetAudioMessage() == nil {
+		t.Fatalf("expected StickerMessage.AudioMessage to be preserved")
+	}
+}

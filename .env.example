# WhatsgoAPI Configuration
SERVER_PORT=9800
GLOBAL_API_KEY=30CHARRANDOMSTRING

# API Client Configuration (for query-whatsgo.js)
WHATS_GO_API_URL=http://localhost:9800

# Database Configuration
POSTGRES_USER=whatsgo
POSTGRES_PASSWORD=password
POSTGRES_DB=whatsgo_dbstd

# MinIO Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zap-mediastd

# Feature Flags
DATABASE_SAVE_MESSAGES=true
CONNECT_ON_STARTUP=true
CHECK_USER_EXISTS=true

# Performance and Logging Settings
LOG_LEVEL=INFO
LOG_MESSAGE_DETAILS=false
LOG_SUMMARY_INTERVAL_SEC=15
WEBHOOK_FILES=false
FETCH_GROUP_INFO_ON_MESSAGE=false
GROUP_INFO_CACHE_TTL_MIN=30
